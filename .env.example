# Database Configuration (External PostgreSQL)
DB_HOST=localhost
DB_NAME=ShoppeFakeDB
DB_USER=postgres
DB_PASSWORD=YourPasswordHere123!
DB_PORT=5432

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# PostgreSQL Connection String (customize with your external DB)
# Format: Server=host;Port=port;Database=dbname;User Id=user;Password=password;
DEFAULT_CONNECTION=Server=localhost;Port=5432;Database=ShoppeFakeDB;User Id=postgres;Password=YourPasswordHere123!;

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-this-in-production-with-at-least-32-chars
JWT_ISSUER=ShoppeFakeAPI
JWT_AUDIENCE=ShoppeFakeClient
JWT_EXPIRATION=60

# Email Configuration (Mailgun / Mailtrap)
EMAIL_SMTP_SERVER=smtp.mailtrap.io
EMAIL_SMTP_PORT=2525
EMAIL_SENDER_NAME=ShoppeFake
EMAIL_SENDER_EMAIL=noreply@shoppefake.com
EMAIL_USERNAME=your-mailtrap-username
EMAIL_PASSWORD=your-mailtrap-password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
